	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance> "Derived from luxICDABEG operon terminator of Vibrio fischeri <genbank>AF170104</genbank>." ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel> <https://synbiohub.org/public/igem/1/BBa_B0011> ;
