	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription> "Bidirectional transcriptional terminator consisting of a 22 bp stem-loop.</p>" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#discontinued> "false" ;
