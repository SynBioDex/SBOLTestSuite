	<http://sbols.org/v3#name> "ECFP" ;
	<http://sbols.org/v3#description> "enhanced cyan fluorescent protein derived from A. victoria GFP" ;
	<http://purl.org/dc/terms/created> "2003-01-31T12:00:00Z" ;
	<http://purl.org/dc/terms/modified> "2015-08-31T04:07:25Z" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance> "Modified from <bb_part>BBa_E0021</bb_part>." ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel> <https://synbiohub.org/public/igem/1/BBa_E0022> ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy> <https://synbiohub.org/user/james> , <https://synbiohub.org/user/myers> ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#partStatus> "Released HQ 2013" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription> "Cyan fluorescent protein (ECFP) reporter coding sequence without the Ribosome      Binding Site. Modified with an LVA tail for rapid degradation of the protein      and faster fall time for the emission. </P>" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#discontinued> "false" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#dominant> "false" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#group_u_list> "_1_" ;
