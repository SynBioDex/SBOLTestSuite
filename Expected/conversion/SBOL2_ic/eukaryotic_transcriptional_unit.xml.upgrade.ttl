	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#bookmark> "true" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableNotes> "Aimed to increase binding affinity to the immunogenic PQLP peptide found in gluten" ;
