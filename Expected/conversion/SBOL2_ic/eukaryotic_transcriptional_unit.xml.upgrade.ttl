	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel> <https://synbiohub.org/public/igem/1/BBa_K590087> ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy> <https://synbiohub.org/user/james> , <https://synbiohub.org/user/myers> ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription> "A mutated Kumamolisin-As enzyme aimed to combat gluten intolerance by increased activity with the PQLP peptide, an antigenic epitope in gliadin. This mutant is the best combinatorial mutant found and has point mutations at residues 291, 319, 358, and 368 from Asparagine to Aspartate, Glycine to Serine, Aspartate to Glycine, and Aspartate to Histidine, respectively." ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#discontinued> "false" ;
