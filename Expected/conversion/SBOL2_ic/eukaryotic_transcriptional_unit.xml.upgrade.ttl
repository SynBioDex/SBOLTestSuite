	<http://purl.org/dc/terms/created> "2015-08-26T11:00:00Z" ;
	<http://purl.org/dc/terms/modified> "2015-08-27T04:15:20Z" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance> "It comes from the new part of BBa_K1606029 and the combinations of R0010,K590087,B0034,B0015" ;
