	<http://sbols.org/v3#name> "BBa_I742126" ;
	<http://sbols.org/v3#description> "Reverse lambda cI-regulated promoter" ;
	<http://parts.igem.org/#description> "This is an exact 'upside down' version of BBa_R0051. The promoter has two DNA binding sites for lambda cI repressor BBa_C0051. By adding this part, we wish to emphasise the possibility of engineering both DNA strands, and the additional regulatory potential that it gives." ;
	<http://parts.igem.org/#author> "Caroline Dahl" ;
	<http://parts.igem.org/#source> "See BBa_R0051." ;
	<http://parts.igem.org/#created> "2007-10-22T06:00:00.000Z" ;
	<http://parts.igem.org/#note> "Any 'upside down' (reverse complementary) sequences made by PCR amplification need be made with suffix and prefix is opposite order with respect to the original default sequence." ;
	<http://parts.igem.org/#status> "Planning" ;
	<http://parts.igem.org/#nickname> "revPlam" ;
	<http://sbols.org/v3#type> <https://identifiers.org/SBO:0000251> ;
	<http://sbols.org/v3#hasSequence> <http://parts.igem.org/Part:BBa_I742126#sequence> .
