<http://parts.igem.org/Part:BBa_B0012> a <http://sbols.org/v3#Component> ;
	<https://sbols.org/backport/2_3#sbol2OriginalURI> <http://parts.igem.org/Part:BBa_B0012> ;
	<http://sbols.org/v3#displayId> "BBa_B0012" ;
	<http://sbols.org/v3#name> "BBa_B0012" ;
	<http://sbols.org/v3#description> "TE from coliphageT7" ;
	<http://parts.igem.org/#description> "Transcription terminator for the <i>E.coli</i> RNA polymerase." ;
	<http://parts.igem.org/#author> "Reshma Shetty" ;
	<http://parts.igem.org/#source> "Derived from the TE terminator of T7 bacteriophage between Genes 1.3 and 1.4      <genbank>V01146</genbank>." ;
	<http://parts.igem.org/#created> "2003-01-31T07:00:00.000Z" ;
	<http://parts.igem.org/#note> "<P> <P>Suggested by Sri Kosuri and Drew Endy as a high efficiency terminator. The      5' end cutoff was placed immediately after the TAA stop codon and the 3' end      cutoff was placed just prior to the RBS of Gene 1.4 (before AAGGAG).<P> Use anywhere transcription should be stopped when the gene of interest is upstream of this terminator." ;
	<http://parts.igem.org/#status> "Available" ;
	<http://parts.igem.org/#partStatus> "Released HQ 2013" ;
	<http://sbols.org/v3#type> <https://identifiers.org/SBO:0000251> .
